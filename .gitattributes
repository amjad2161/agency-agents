# Normalize all text files to LF on commit; checkout on Windows gets CRLF
* text=auto eol=lf

# Python source files — always LF
*.py text eol=lf

# Docs / config — always LF
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.rst text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Windows-only scripts — keep CRLF as-is (no LF conversion)
*.bat -text
*.cmd -text
*.ps1 -text
*.psm1 -text

# Binary files — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp4 binary
*.webm binary
*.zip binary
*.gz binary
*.tar binary
*.bundle binary
*.db binary
*.sqlite binary
*.sqlite3 binary
