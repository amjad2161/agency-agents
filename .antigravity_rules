## AGENT BEHAVIOR RULES

agent_rules:
  planning_first: true
  show_implementation_plan_before_coding: true
  ask_before_destructive_actions: true
  auto_commit_policy: "never auto-commit without confirmation"
  context_persistence: "always read existing code before writing new"
  
  forbidden_actions:
    - "Delete files without explicit permission"
    - "Change database schemas without migration plan"
    - "Expose API keys in code"
    - "Override working functionality without backup"
  
  mandatory_actions:
    - "Check existing code before creating new files"
    - "Run tests after every significant change"
    - "Document all environment variable requirements"
    - "Create reversible changes where possible"

